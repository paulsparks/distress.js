{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext", "DOM"],
        "moduleResolution": "node",
        "verbatimModuleSyntax": true,
        "noEmit": false,
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "outDir": "dist"
    },
    "include": ["src"]
}
